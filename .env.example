# Copy to .env and adjust. Never commit .env.

# --- Local Postgres (read by docker compose) ---------------------------------------

# Postgres role that owns the database (used by docker compose and the app).
POSTGRES_USER=fineprint
# Local-development password only; use a real secret anywhere else.
POSTGRES_PASSWORD=fineprint
# Database holding the handbook chunks and their embeddings.
POSTGRES_DB=fineprint
# Host port the docker compose "db" service publishes; change if 5432 is taken.
POSTGRES_PORT=5432

# --- The service (read by fineprint.config.Settings) -------------------------------

# Connection string the application uses; must match the four values above.
DATABASE_URL=postgresql://fineprint:fineprint@localhost:5432/fineprint
# Which handbook edition queries run against.
CORPUS_EDITION=2026
# Which set of chunks queries run against; one name per chunking configuration.
CHUNK_SET=fixed-220w

# Where the answering model is called; "bedrock" is the only provider part 1 implements.
LLM_PROVIDER=bedrock
# Bedrock model id of the model that writes answers.
LLM_MODEL=us.anthropic.claude-opus-5
# Where the embedding model is called; "bedrock" is the only provider part 1 implements.
EMBEDDING_PROVIDER=bedrock
# Bedrock model id of the model that turns text into vectors; its output width must equal the
# vector(...) width of the chunks.embedding column in src/fineprint/schema.sql.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# AWS region both Bedrock models are called in.
AWS_REGION=us-west-2
# The AWS profile is NOT read from this file. boto3 takes it from the shell environment, so run
# `export AWS_PROFILE=<your profile>` in the shell you work in; without it boto3 uses the default
# credential chain. Credentials themselves never belong in this file.

# How many rows each retriever returns before fusion.
RETRIEVAL_CANDIDATES=20
# How many chunks survive fusion and are sent to the model.
RETRIEVAL_TOP_K=5
# The constant in the reciprocal rank fusion formula.
RRF_K=60
