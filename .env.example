# Copy to .env and adjust. Never commit .env.

# --- Local Postgres (read by docker compose) ---------------------------------------

# Postgres role that owns the database (used by docker compose and the app).
POSTGRES_USER=fineprint
# Local-development password only; use a real secret anywhere else.
POSTGRES_PASSWORD=fineprint
# Database holding the handbook chunks and their embeddings.
POSTGRES_DB=fineprint
# Host port the docker compose "db" service publishes; change if 5432 is taken.
POSTGRES_PORT=5432

# --- The service (read by fineprint.config.Settings) -------------------------------

# Connection string the application uses; must match the four values above.
DATABASE_URL=postgresql://fineprint:fineprint@localhost:5432/fineprint
# Which handbook edition queries run against.
CORPUS_EDITION=2026
# Which set of chunks queries run against; one name per chunking configuration. "sections" is
# the best configuration on the part 2 scoreboard, together with RERANKER_PROVIDER=bedrock below;
# "fixed-220w" is part 1's chunker, which the part 1 eval commands read.
CHUNK_SET=sections

# Where the answering model is called; "bedrock" is the only provider part 1 implements.
LLM_PROVIDER=bedrock
# Bedrock model id of the model that writes answers.
LLM_MODEL=us.anthropic.claude-opus-5
# Where the embedding model is called; "bedrock" is the only provider part 1 implements.
EMBEDDING_PROVIDER=bedrock
# Bedrock model id of the model that turns text into vectors; its output width must equal the
# vector(...) width of the chunks.embedding column in src/fineprint/schema.sql.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# Re-ranking between fusion and the top-k cut: "none" skips it, "bedrock" uses RERANKER_MODEL.
# "bedrock" with CHUNK_SET=sections is the best configuration on the part 2 scoreboard.
RERANKER_PROVIDER=bedrock
# Bedrock model id of the model that re-orders the fused candidates.
RERANKER_MODEL=cohere.rerank-v3-5:0
# How many fused candidates the re-ranker reads before the top-k cut.
RERANK_CANDIDATES=20
# Bedrock model id of the judge that scores the four RAGAS metrics; the service never calls it.
JUDGE_MODEL=us.anthropic.claude-sonnet-5

# Bedrock model id of the model that answers when LLM_MODEL is unavailable; empty turns it off.
FALLBACK_LLM_MODEL=us.anthropic.claude-sonnet-5
# Seconds one request to the answer or fallback model may take before it counts as a timeout.
LLM_TIMEOUT_SECONDS=60
# How many times the SDK retries throttling and server errors before giving up on a request.
LLM_MAX_RETRIES=4
# Read timeout in seconds for the embedder and the re-ranker; the connect timeout is fixed at 5.
AWS_TIMEOUT_SECONDS=10
# Attempts botocore makes per embedder or re-ranker call, the first try included.
AWS_MAX_ATTEMPTS=4
# How many tool turns the agent may take before it must record its answer.
AGENT_MAX_TOOL_TURNS=4
# A test and demo switch that makes one call fail on purpose, as <target>:<fault>[:once], for
# example chat:unavailable:once. Targets: chat, embedding, rerank. Faults: unavailable, timeout.
FAULT_INJECTION=

# Where traces go: "none" keeps cost and latency in the process, "langfuse" also sends them to
# Langfuse, which needs the three values below.
TRACING_PROVIDER=none
# Langfuse project public key; leave empty while TRACING_PROVIDER=none.
LANGFUSE_PUBLIC_KEY=
# Langfuse project secret key; never commit a real one.
LANGFUSE_SECRET_KEY=
# Langfuse region URL from the project's settings page, for example https://us.cloud.langfuse.com.
LANGFUSE_BASE_URL=

# AWS region every Bedrock model is called in.
AWS_REGION=us-west-2
# The AWS profile is NOT read from this file. boto3 takes it from the shell environment, so run
# `export AWS_PROFILE=<your profile>` in the shell you work in; without it boto3 uses the default
# credential chain. Credentials themselves never belong in this file.

# How many rows each retriever returns before fusion.
RETRIEVAL_CANDIDATES=20
# How many chunks survive fusion and are sent to the model.
RETRIEVAL_TOP_K=5
# The constant in the reciprocal rank fusion formula.
RRF_K=60
